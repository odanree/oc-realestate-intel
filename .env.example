# --- LLM ---
ANTHROPIC_API_KEY=sk-ant-...
ANTHROPIC_MODEL=claude-sonnet-4-6

# --- Postgres ---
DATABASE_URL=postgresql+asyncpg://oci:oci@localhost:5434/oci

# --- Qdrant ---
QDRANT_URL=http://localhost:6333
QDRANT_COLLECTION=parcels

# --- Neo4j ---
NEO4J_URI=bolt://localhost:7688
NEO4J_USER=neo4j
NEO4J_PASSWORD=ocirealestate

# --- Optional 3rd party ---
ATTOM_API_KEY=
ZILLOW_API_KEY=

# --- Langfuse (LLM observability) ---
# Sign up at langfuse.com (US: https://us.cloud.langfuse.com, EU: https://cloud.langfuse.com)
# Project Settings → API keys. Leave blank to disable tracing.
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://us.cloud.langfuse.com

# --- App ---
LOG_LEVEL=INFO
